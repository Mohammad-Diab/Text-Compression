<Window x:Class="WpfApplication10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ضغط النصوص" FlowDirection="RightToLeft" Width="650" Height="380" Loaded="Window_Loaded_1" Icon="pro.ico">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="31*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TextBox1" Margin="10" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Visible"/>
        <TextBox x:Name="TextBlock1" Margin="10,10,10,45" TextWrapping="Wrap" Grid.Row="1" VerticalScrollBarVisibility="Visible" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True"/>
        <Button Content="اضغط" HorizontalAlignment="Left" Height="30" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="110" Grid.Row="1" Click="Compress_Click_1"/>
        <Button Content="فك الضغط" HorizontalAlignment="Right" Height="30" Margin="0,0,10,10" Grid.Row="1" VerticalAlignment="Bottom" Width="110" Click="Decompress_Click_3"/>
        <Button Content="اضغط ملف" HorizontalAlignment="Left" Height="30" Margin="130,0,0,10" VerticalAlignment="Bottom" Width="110" Grid.Row="1" Click="Compress_File_Click_3"/>
        <Button Content="فك الضغط الى ملف" HorizontalAlignment="Right" Height="30" Margin="0,0,130,10" VerticalAlignment="Bottom" Width="110" Grid.Row="1" Click="Decompress_to_File_Click_3"/>
        <ComboBox x:Name="ComboBox1" Margin="254,0,254,11" Grid.Row="1" VerticalAlignment="Bottom" SelectedIndex="5" FontSize="16" FlowDirection="LeftToRight" SelectionChanged="ComboBox_SelectionChanged_1">
            <ComboBoxItem Content="ASCII"/>
            <ComboBoxItem Content="BigEndianUnicode"/>
            <ComboBoxItem Content="Unicode"/>
            <ComboBoxItem Content="UTF32"/>
            <ComboBoxItem Content="UTF7"/>
            <ComboBoxItem Content="UTF8"/>
        </ComboBox>

    </Grid>
</Window>
